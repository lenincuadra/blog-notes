---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostFilter from '../components/PostFilter.astro';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// Only the posts tagged "practice". The portfolio links to this page.
const posts = (await getCollection('blog', ({ data }) => data.tags.includes('practice'))).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Practice | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<PostFilter current="/practice/" />
			<PostList posts={posts} />
		</main>
		<Footer />
	</body>
</html>
