---
// EXPERIMENT (branch experimento/cuaderno): the open notebook. The posts as a notebook, two pages at a
// time on a computer and one on a phone, with a page-turn effect. It changes nothing else: what it needs
// is in this file (its styles too), no other page links here and search engines are asked to skip it.
import { getCollection, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Tag from '../components/Tag.astro';
import UiText from '../components/UiText.astro';
import { SITE_TITLE } from '../consts';
import { getTranslations, TRANSLATED_FROM, UI, WRITTEN_IN } from '../i18n';

const translations = await getTranslations();
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
// Page 1 is the contents; each post takes the next page, newest first
const pages = await Promise.all(
	posts.map(async (post, i) => {
		const translation = translations.get(post.id);
		return {
			post,
			translation,
			number: i + 2,
			Content: (await render(post)).Content,
			Translated: translation ? (await render(translation.entry)).Content : undefined,
		};
	}),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${UI.notebookTitle.en} | ${SITE_TITLE}`} description={UI.notebookIntro.en} />
		<meta name="robots" content="noindex" />
	</head>
	<body>
		<Header />
		<main class="cuaderno">
			<header class="intro">
				<h1><UiText text={UI.notebookTitle} /></h1>
				<p><UiText text={UI.notebookIntro} /></p>
			</header>

			<div class="book" data-book>
				<div class="page page-left" data-slot="left"></div>
				<div class="page page-right" data-slot="right"></div>
			</div>

			<div class="turns">
				<button class="notes-button" type="button" data-turn="-1">
					<span aria-hidden="true">←</span>&nbsp;<UiText text={UI.notebookPrevious} />
				</button>
				<p class="count" aria-live="polite">
					<UiText text={UI.notebookPages} /> <span data-count></span>
				</p>
				<button class="notes-button" type="button" data-turn="1">
					<UiText text={UI.notebookNext} />&nbsp;<span aria-hidden="true">→</span>
				</button>
			</div>

			<!-- The pages, ready to be copied into the book: the contents, then one page per post -->
			<div hidden data-pages>
				<section data-number="1">
					<h2 class="contents-title"><UiText text={UI.notebookContents} /></h2>
					<ol class="contents">
						{
							pages.map(({ post, translation, number }) => (
								<li>
									<button type="button" data-go={number - 1}>
										<span class="contents-name">
											{translation ? (
												<Fragment>
													<span data-ui={post.data.lang} lang={post.data.lang}>{post.data.title}</span><span data-ui={translation.lang} lang={translation.lang}>{translation.entry.data.title}</span>
												</Fragment>
											) : (
												<span lang={post.data.lang}>{post.data.title}</span>
											)}
										</span>
										<span class="contents-dots" aria-hidden="true"></span>
										<span class="contents-number">{number}</span>
									</button>
								</li>
							))
						}
					</ol>
				</section>
				{
					pages.map(({ post, translation, number, Content, Translated }) => (
						<section data-number={number}>
							<article class="post" data-translation={translation?.lang}>
								<p class="post-meta">
									<FormattedDate date={post.data.pubDate} />
									{post.data.tags.map((tag) => (
										<Tag tag={tag} />
									))}
								</p>
								<h2 class="post-title" lang={post.data.lang} data-version={translation && 'original'}>
									{post.data.title}
								</h2>
								{translation && (
									<h2 class="post-title" lang={translation.lang} data-version="translation">
										{translation.entry.data.title}
									</h2>
								)}
								<p class="post-version" data-version={translation && 'original'}>
									<UiText text={WRITTEN_IN[post.data.lang]} />
								</p>
								{translation && (
									<p class="post-version" data-version="translation">
										<UiText text={TRANSLATED_FROM[post.data.lang]} />
									</p>
								)}
								<div class="prose" lang={post.data.lang} data-version={translation && 'original'}>
									<Content />
								</div>
								{translation && Translated && (
									<div class="prose" lang={translation.lang} data-version="translation">
										<Translated />
									</div>
								)}
							</article>
						</section>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>

<script>
	// Copies the pages into the book and turns them. On a computer the book shows two pages and a turn
	// flips the sheet over the spine; on a phone it shows one, and with "reduce motion" it just changes.
	const book = document.querySelector<HTMLElement>('[data-book]')!;
	const pages = [...document.querySelectorAll<HTMLElement>('[data-pages] > section')];
	const left = book.querySelector<HTMLElement>('[data-slot="left"]')!;
	const right = book.querySelector<HTMLElement>('[data-slot="right"]')!;
	const count = document.querySelector<HTMLElement>('[data-count]')!;
	const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-turn]')];
	const wide = matchMedia('(min-width: 60rem)');
	const calm = matchMedia('(prefers-reduced-motion: reduce)');
	// The first page in view: the left one of the spread on a computer, the only one on a phone
	let first = 0;
	let turning = false;

	const step = () => (wide.matches ? 2 : 1);

	function put(slot: HTMLElement, i: number) {
		const page = pages[i]?.cloneNode(true) as HTMLElement | undefined;
		slot.replaceChildren(...(page ? [page] : []));
		slot.dataset.number = page?.dataset.number ?? '';
	}

	function update() {
		if (wide.matches) {
			put(left, first);
			put(right, first + 1);
		} else {
			put(right, first);
			left.replaceChildren();
		}
		const last = Math.min(first + step(), pages.length);
		count.textContent = `${first + 1}${last > first + 1 ? `–${last}` : ''} / ${pages.length}`;
		buttons[0].disabled = first === 0;
		buttons[1].disabled = first + step() >= pages.length;
	}

	function go(target: number) {
		const to = wide.matches ? target - (target % 2) : target;
		if (turning || to === first || to < 0 || to >= pages.length) return;
		if (calm.matches || !wide.matches) {
			first = to;
			update();
			return;
		}
		// The sheet that turns: its front is the page being turned, its back the page it reveals
		turning = true;
		const forward = to > first;
		const sheet = document.createElement('div');
		sheet.className = `sheet ${forward ? 'is-forward' : 'is-back'}`;
		const front = document.createElement('div');
		const back = document.createElement('div');
		front.className = `face page ${forward ? 'page-right' : 'page-left'}`;
		back.className = `face face-back page ${forward ? 'page-left' : 'page-right'}`;
		if (forward) {
			put(front, first + 1);
			put(back, to);
			put(right, to + 1);
		} else {
			put(front, first);
			put(back, to + 1);
			put(left, to);
		}
		sheet.append(front, back);
		book.append(sheet);
		sheet.getBoundingClientRect();
		sheet.classList.add('is-turning');
		sheet.addEventListener(
			'transitionend',
			() => {
				first = to;
				update();
				sheet.remove();
				turning = false;
			},
			{ once: true },
		);
	}

	buttons.forEach((button) => button.addEventListener('click', () => go(first + Number(button.dataset.turn) * step())));
	book.addEventListener('click', (event) => {
		const link = (event.target as HTMLElement).closest<HTMLElement>('[data-go]');
		if (link) go(Number(link.dataset.go));
	});
	document.addEventListener('keydown', (event) => {
		if (event.key === 'ArrowRight') go(first + step());
		if (event.key === 'ArrowLeft') go(first - step());
	});
	wide.addEventListener('change', () => {
		if (wide.matches) first -= first % 2;
		update();
	});
	update();
</script>

<style is:global>
	/* Everything here hangs from .cuaderno, so it touches no other page */
	.cuaderno .intro {
		display: grid;
		gap: var(--sp-2);
	}

	.cuaderno .intro h1 {
		margin: 0;
		font-family: var(--notes-hand);
		font-size: 2rem;
		font-weight: 600;
		line-height: 1.2;
		color: var(--ink);
	}

	.cuaderno .intro p {
		margin: 0;
		font-size: 1rem;
		color: var(--ink-3);
	}

	/* The book breaks out of the text column: two pages need more room */
	.cuaderno .book {
		--book: min(72rem, calc(100vw - 2 * var(--sp-4)));
		--page-height: min(74vh, 46rem);
		position: relative;
		display: grid;
		grid-template-columns: 1fr;
		width: var(--book);
		margin-inline: calc((100% - var(--book)) / 2);
		perspective: 2800px;
	}

	@media (min-width: 60rem) {
		.cuaderno .book {
			grid-template-columns: 1fr 1fr;
		}
	}

	.cuaderno .page {
		position: relative;
		height: var(--page-height);
		overflow: auto;
		padding: var(--sp-8) var(--sp-8) var(--sp-12);
		background-color: var(--bg-card);
		background-image: radial-gradient(circle, var(--notes-dot) 1px, transparent 1.3px);
		background-size: 18px 18px;
		box-shadow: 0 18px 40px -28px color-mix(in srgb, var(--ink) 55%, transparent);
	}

	/* The spine: each page darkens a little toward the middle */
	.cuaderno .page-left {
		border-radius: var(--r-md) 0 0 var(--r-md);
		background-image:
			linear-gradient(to left, color-mix(in srgb, var(--ink) 10%, transparent), transparent 2.5rem),
			radial-gradient(circle, var(--notes-dot) 1px, transparent 1.3px);
		background-size: auto, 18px 18px;
	}

	.cuaderno .page-right {
		border-radius: 0 var(--r-md) var(--r-md) 0;
		background-image:
			linear-gradient(to right, color-mix(in srgb, var(--ink) 10%, transparent), transparent 2.5rem),
			radial-gradient(circle, var(--notes-dot) 1px, transparent 1.3px);
		background-size: auto, 18px 18px;
	}

	@media (max-width: 59.99rem) {
		.cuaderno .page-left {
			display: none;
		}

		.cuaderno .page-right {
			border-radius: var(--r-md);
			padding: var(--sp-6) var(--sp-5) var(--sp-12);
		}
	}

	/* The page number, in the outer bottom corner */
	.cuaderno .page::after {
		content: attr(data-number);
		position: absolute;
		bottom: var(--sp-4);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--ink-3);
	}

	.cuaderno .page-left::after {
		left: var(--sp-6);
	}

	.cuaderno .page-right::after {
		right: var(--sp-6);
	}

	/* The sheet that turns over the spine */
	.cuaderno .sheet {
		position: absolute;
		z-index: 3;
		top: 0;
		width: 50%;
		height: var(--page-height);
		transform-style: preserve-3d;
		transition: transform 0.9s cubic-bezier(0.645, 0.045, 0.355, 1);
	}

	.cuaderno .sheet.is-forward {
		left: 50%;
		transform-origin: left center;
	}

	.cuaderno .sheet.is-back {
		left: 0;
		transform-origin: right center;
	}

	.cuaderno .sheet.is-forward.is-turning {
		transform: rotateY(-180deg);
	}

	.cuaderno .sheet.is-back.is-turning {
		transform: rotateY(180deg);
	}

	.cuaderno .face {
		position: absolute;
		inset: 0;
		overflow: hidden;
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
	}

	.cuaderno .face-back {
		transform: rotateY(180deg);
	}

	/* The post, a size smaller to fit the page */
	.cuaderno .post {
		gap: var(--sp-4);
	}

	.cuaderno .post-title {
		font-size: 2rem;
	}

	/* The contents: the titles, dotted leaders and page numbers */
	.cuaderno .contents-title {
		margin: 0 0 var(--sp-6);
		font-family: var(--notes-hand);
		font-size: 2rem;
		font-weight: 600;
		color: var(--ink);
	}

	.cuaderno .contents {
		display: grid;
		gap: var(--sp-4);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.cuaderno .contents button {
		display: flex;
		align-items: baseline;
		gap: var(--sp-2);
		width: 100%;
		padding: 0;
		text-align: left;
		font-family: var(--notes-body);
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--ink);
	}

	.cuaderno .contents-name span {
		background: linear-gradient(transparent 58%, var(--notes-mark) 58%) no-repeat 0 0 / 0% 100%;
		transition: background-size var(--dur-mid) var(--ease-out);
	}

	.cuaderno .contents button:hover .contents-name span {
		background-size: 100% 100%;
	}

	.cuaderno .contents-dots {
		flex: 1;
		min-width: var(--sp-4);
		border-bottom: 2px dotted var(--border);
	}

	.cuaderno .contents-number {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 400;
		color: var(--ink-3);
	}

	/* Turning by hand: the buttons and the page count */
	.cuaderno .turns {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: var(--sp-4);
	}

	.cuaderno .turns button:disabled {
		opacity: 0.4;
		cursor: default;
	}

	.cuaderno .count {
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-3);
	}
</style>
