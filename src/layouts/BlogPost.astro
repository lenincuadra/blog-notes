---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

// Pages like About use this layout without a date, tags or language, so they are optional here.
type Props = Omit<CollectionEntry<'blog'>['data'], 'pubDate' | 'tags' | 'lang'> & {
	pubDate?: Date;
	tags?: string[];
	lang?: CollectionEntry<'blog'>['data']['lang'];
};

// The page takes the post's language (English by default), so screen readers and search engines read it right
const { title, description, pubDate, updatedDate, heroImage, tags = [], lang = 'en' } = Astro.props;
---

<html lang={lang}>
	<head>
		<!-- The full name in every title, as on the other pages: the tab and search results say whose notes these are -->
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description} />
	</head>

	<body>
		<Header />
		<main>
			<article class="post">
				<header class="post-header">
					{
						pubDate && (
							<p class="post-meta">
								<FormattedDate date={pubDate} />
								{updatedDate && (
									<span>
										Updated{' '}
										<FormattedDate date={updatedDate} />
									</span>
								)}
								{tags.map((tag) => <span class={`tag tag-${tag}`}>{tag}</span>)}
							</p>
						)
					}
					<h1 class="post-title">{title}</h1>
				</header>
				{heroImage && <Image class="post-hero" width={1020} height={510} src={heroImage} alt="" />}
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
