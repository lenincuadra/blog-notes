---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Tag from '../components/Tag.astro';
import UiText from '../components/UiText.astro';
import { SITE_TITLE } from '../consts';
import { type Language, TRANSLATED_FROM, UI, WRITTEN_IN } from '../i18n';

// Pages like About use this layout without a date, tags or language, so they are optional here.
type Props = Omit<CollectionEntry<'blog'>['data'], 'pubDate' | 'tags' | 'lang'> & {
	pubDate?: Date;
	tags?: string[];
	lang?: Language;
	// The translation, if there is one: its language and title. Its text goes in the "translation" slot.
	translation?: { lang: Language; title: string };
	// The line under the title that says the post's language: "Written in Spanish", or "Translated from
	// Spanish · See the original" over a translation. About isn't a post, so it doesn't say it.
	languageNote?: boolean;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	lang = 'en',
	translation,
	languageNote = true,
} = Astro.props;
// With a translation the page carries both versions and shows the one in the reader's language (global.css).
// Each one says its language, so screen readers and search engines read it right.
const version = (name: string) => (translation ? name : undefined);
---

<html lang="en">
	<head>
		<!-- The full name in every title, as on the other pages: the tab and search results say whose notes these are -->
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description} />
	</head>

	<body>
		<Header />
		<main>
			<article class="post" data-translation={translation?.lang}>
				<header class="post-header">
					{
						pubDate && (
							<p class="post-meta">
								<FormattedDate date={pubDate} />
								{updatedDate && (
									<span>
										<UiText text={UI.updated} /> <FormattedDate date={updatedDate} />
									</span>
								)}
								{tags.map((tag) => (
									<Tag tag={tag} />
								))}
							</p>
						)
					}
					<h1 class="post-title" lang={lang} data-version={version('original')}>{title}</h1>
					{
						translation && (
							<h1 class="post-title" lang={translation.lang} data-version="translation">
								{translation.title}
							</h1>
						)
					}
					{
						languageNote && (
							<p class="post-version" data-version={version('original')}>
								<UiText text={WRITTEN_IN[lang]} />
								{translation && (
									<span data-version="back">
										{' '}·{' '}
										<button type="button" data-show="">
											<UiText text={UI.seeTranslation} />
										</button>
									</span>
								)}
							</p>
						)
					}
					{
						translation && languageNote && (
							<p class="post-version" data-version="translation">
								<UiText text={TRANSLATED_FROM[lang]} /> ·{' '}
								<button type="button" data-show="original">
									<UiText text={UI.seeOriginal} />
								</button>
							</p>
						)
					}
				</header>
				{heroImage && <Image class="post-hero" width={1020} height={510} src={heroImage} alt="" />}
				<div class="prose" lang={lang} data-version={version('original')}>
					<slot />
				</div>
				{
					translation && (
						<div class="prose" lang={translation.lang} data-version="translation">
							<slot name="translation" />
						</div>
					)
				}
			</article>
		</main>
		<Footer />
	</body>
</html>

<script>
	// "See the original" and "See the translation", under the title of a translated post
	document.querySelectorAll<HTMLButtonElement>('.post-version button').forEach((button) => {
		button.addEventListener('click', () => {
			const post = button.closest<HTMLElement>('.post');
			if (!post) return;
			if (button.dataset.show) post.dataset.show = button.dataset.show;
			else delete post.dataset.show;
		});
	});
</script>
