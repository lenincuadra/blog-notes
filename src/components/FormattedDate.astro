---
// A date in both languages: "Oct 16, 2026" in English and "16 oct 2026" in Spanish (see src/i18n.ts)
import { formatDate } from '../i18n';
import UiText from './UiText.astro';

interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}><UiText text={formatDate(date)} /></time>
