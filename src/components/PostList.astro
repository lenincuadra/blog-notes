---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getTranslations, ORIGINALLY_IN, WRITTEN_IN } from '../i18n';
import FormattedDate from './FormattedDate.astro';
import Tag from './Tag.astro';
import UiText from './UiText.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
// A translated post shows its title in the reader's language: both titles are in the page
const translations = await getTranslations();
---

<ul class="post-list">
	{
		posts.map((post) => {
			const translation = translations.get(post.id);
			return (
				<li>
					<a class:list={['post-card', { 'post-card--practice': post.data.tags.includes('practice') }]} href={`/${post.id}/`}>
						{post.data.heroImage && (
							<Image class="post-card-image" width={720} height={360} src={post.data.heroImage} alt="" />
						)}
						<span class="post-card-title">
							{translation ? (
								<Fragment>
									<span data-ui={post.data.lang} lang={post.data.lang}>{post.data.title}</span><span data-ui={translation.lang} lang={translation.lang}>{translation.entry.data.title}</span>
								</Fragment>
							) : (
								<span lang={post.data.lang}>{post.data.title}</span>
							)}
						</span>
						<span class="post-card-meta">
							<FormattedDate date={post.data.pubDate} />
							{post.data.tags.map((tag) => (
								<Tag tag={tag} />
							))}
							<span class="lang-mark">
								<span class="lang-mark-code" aria-hidden="true">{post.data.lang}</span>
								<span class="lang-mark-words" aria-hidden="true">
									<UiText text={WRITTEN_IN[post.data.lang]} />
								</span>
								<span class="tip" aria-hidden="true">
									<UiText text={ORIGINALLY_IN[post.data.lang]} />
								</span>
								<span class="visually-hidden">
									<UiText text={ORIGINALLY_IN[post.data.lang]} />
								</span>
							</span>
						</span>
					</a>
				</li>
			);
		})
	}
</ul>
