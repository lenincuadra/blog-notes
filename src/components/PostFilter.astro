---
// Filters for the post list. Each filter is its own page, so the portfolio
// can link straight to a filtered view. View All is the front page, where
// visitors arrive on their own; the portfolio links to Practice. To add a
// filter, list it here and create its page in src/pages/.
import { UI } from '../i18n';
import UiText from './UiText.astro';

const filters = [
	{ label: UI.viewAll, href: '/' },
	{ label: UI.personal, href: '/personal/' },
	{ label: UI.practice, href: '/practice/' },
];

interface Props {
	// URL of the filter being shown, e.g. '/' or '/practice/'
	current: string;
}

const { current } = Astro.props;
---

<nav class="filter" aria-label={UI.filter.en} data-aria-en={UI.filter.en} data-aria-es={UI.filter.es}>
	{
		filters.map(({ label, href }, i) => (
			<Fragment>
				{i > 0 && ' · '}
				{href === current ? (
					<strong aria-current="page">
						<UiText text={label} />
					</strong>
				) : (
					<a href={href}>
						<UiText text={label} />
					</a>
				)}
			</Fragment>
		))
	}
</nav>
