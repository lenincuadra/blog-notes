---
import { SITE_AUTHOR, SITE_NAME, SITE_TITLE } from '../consts';
import { UI } from '../i18n';
import HeaderLink from './HeaderLink.astro';
import UiText from './UiText.astro';
---

<header class="notes-header">
	<a class="brand" href="/" aria-label={SITE_TITLE}>
		<svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
			<rect
				class="brand-mark-bar"
				x="8.52"
				y="32.65"
				width="46.95"
				height="13.61"
				rx="3"
				transform="rotate(-6 32 39.45)"></rect>
			<path
				fill="currentColor"
				d="M24.55 15.80L26.67 23.13L26.67 44.85L30.33 46.37L30.33 48.20L11.95 48.20L11.95 46.37L16.31 44.61L16.31 24.96Q15.54 23.94 14.43 23.14Q13.32 22.35 11.52 21.51L11.52 21.51L11.52 19.92L23.18 15.80L24.55 15.80ZM33.99 48.20L33.99 46.37L37.69 44.85L37.69 28.06Q37.69 26.47 37.12 25.45Q36.56 24.43 35.40 23.92Q34.24 23.41 32.44 23.41L32.44 23.41Q30.40 23.41 28.60 23.97Q26.81 24.54 25.64 25.42L25.64 25.42L24.34 23.69Q26.84 21.15 28.74 19.61Q30.64 18.06 32.19 17.23Q33.74 16.40 35.24 16.10Q36.74 15.80 38.36 15.80L38.36 15.80Q43.29 15.80 45.64 18.65Q48.00 21.51 48.00 27.35L48.00 27.35L48.00 44.61L52.48 46.37L52.48 48.20L33.99 48.20Z"
			></path>
		</svg>
		<span class="brand-name">
			<span class="brand-title">{SITE_NAME}</span>
			<span class="brand-by">by {SITE_AUTHOR}</span>
		</span>
	</a>
	<nav class="notes-nav" aria-label={UI.mainNav.en} data-aria-en={UI.mainNav.en} data-aria-es={UI.mainNav.es}>
		<HeaderLink href="/about"><UiText text={UI.about} /></HeaderLink>
		<!-- The portfolio's language switch and theme toggle; their styles come from its header.css -->
		<div
			class="lang-switch"
			role="group"
			aria-label={UI.language.en}
			data-aria-en={UI.language.en}
			data-aria-es={UI.language.es}
		>
			<button class="lang-switch__btn" type="button" data-lang="en" lang="en">EN</button>
			<button class="lang-switch__btn" type="button" data-lang="es" lang="es">ES</button>
		</div>
		<button
			class="theme-toggle"
			id="theme-toggle"
			type="button"
			aria-label={UI.darkMode.en}
			data-aria-en={UI.darkMode.en}
			data-aria-es={UI.darkMode.es}
			aria-pressed="false"
		>
			<svg
				class="icon-moon"
				aria-hidden="true"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.5"
			>
				<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
			</svg>
			<svg
				class="icon-sun"
				aria-hidden="true"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.5"
			>
				<circle cx="12" cy="12" r="5"></circle>
				<line x1="12" y1="1" x2="12" y2="3"></line>
				<line x1="12" y1="21" x2="12" y2="23"></line>
				<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
				<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
				<line x1="1" y1="12" x2="3" y2="12"></line>
				<line x1="21" y1="12" x2="23" y2="12"></line>
				<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
				<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
			</svg>
		</button>
	</nav>
</header>

<!--
	EN/ES. The texts follow the language by themselves (global.css); this marks the active button and
	sets the labels screen readers hear. It runs right here, so the switch never shows the wrong button,
	and again when the whole page is in.
-->
<script is:inline>
	(() => {
		const root = document.documentElement;
		const apply = (lang) => {
			root.dataset.uiLang = lang;
			root.lang = lang;
			document.querySelectorAll('.lang-switch__btn').forEach((button) => {
				const active = button.dataset.lang === lang;
				button.classList.toggle('lang-switch__btn--active', active);
				button.setAttribute('aria-pressed', String(active));
			});
			document.querySelectorAll('[data-aria-en]').forEach((element) => {
				element.setAttribute('aria-label', lang === 'es' ? element.dataset.ariaEs : element.dataset.ariaEn);
			});
		};
		apply(root.dataset.uiLang || 'en');
		document.addEventListener('DOMContentLoaded', () => apply(root.dataset.uiLang || 'en'));
		document.querySelectorAll('.lang-switch__btn').forEach((button) => {
			button.addEventListener('click', () => {
				try {
					localStorage.setItem('lang', button.dataset.lang);
				} catch (e) {}
				apply(button.dataset.lang);
			});
		});
	})();
</script>

<script>
	// Light is the default. The reader's choice is saved so the next visit keeps it.
	const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
	const root = document.documentElement;
	toggle?.setAttribute('aria-pressed', String(root.classList.contains('theme-dark')));
	toggle?.addEventListener('click', () => {
		const dark = root.classList.toggle('theme-dark');
		toggle.setAttribute('aria-pressed', String(dark));
		try {
			localStorage.setItem('theme', dark ? 'dark' : 'light');
		} catch {}
	});
</script>
