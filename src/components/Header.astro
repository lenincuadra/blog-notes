---
import { SITE_AUTHOR, SITE_NAME } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<a class="brand" href="/">
		<svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
			<rect class="brand-mark-bar" x="8" y="31" width="48" height="15" rx="3" transform="rotate(-6 32 38.5)"
			></rect>
			<path
				fill="currentColor"
				d="M12.93 48.47L16.96 46.94L16.96 17.20L12.47 15.10L12.47 13.68L26.84 13.68L45.84 41.48L43.77 43.12L43.77 16.71L39.36 15.21L39.36 13.68L51.53 13.68L51.53 15.21L47.50 16.71L47.50 50.16L41.05 50.16L19.13 17.57L20.69 16.66L20.69 46.94L25.10 48.47L25.10 50L12.93 50L12.93 48.47Z"
			></path>
		</svg>
		<span class="brand-name">
			<span class="brand-title">{SITE_NAME}</span>
			<span class="brand-by">by {SITE_AUTHOR}</span>
		</span>
	</a>
	<nav class="site-nav" aria-label="Main">
		<HeaderLink href="/about">About</HeaderLink>
		<button class="theme-toggle" type="button">
			<span class="sr-only">Switch to </span><span class="theme-toggle-dark">dark</span><span
				class="theme-toggle-light">light</span
			><span class="sr-only"> mode</span>
		</button>
	</nav>
</header>

<script>
	// Light is the default. The reader's choice is saved so the next visit keeps it.
	const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
	toggle?.addEventListener('click', () => {
		const dark = document.documentElement.classList.toggle('theme-dark');
		try {
			localStorage.setItem('theme', dark ? 'dark' : 'light');
		} catch {}
	});
</script>
